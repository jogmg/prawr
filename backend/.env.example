# Backend - NestJS server

# Server port
PORT=3001

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/prawr

# JWT secret for any auth tokens
JWT_SECRET=dev-secret-change-in-prod

# Arc Mainnet RPC for viem public client
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042

# Circle Gateway - server-side facilitator configuration
# Optional fallback recipient; each stream payment targets its creatorWallet field.
GATEWAY_SELLER_ADDRESS=

# Gateway API key from Circle Developer Dashboard
GATEWAY_API_KEY=your_live_api_key_here

# Gateway facilitator URL (default Circle Gateway)
GATEWAY_FACILITATOR_URL=https://gateway-api.circle.com

# Arc Mainnet CAIP-2 chain identifier
GATEWAY_CHAIN=eip155:5042

# Optional live status checks for YouTube and Twitch streams.
# YouTube checks require YOUTUBE_API_KEY. Twitch checks require both Twitch values.
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Poll interval in milliseconds; values below 10000 disable status polling.
STREAM_STATUS_CHECK_INTERVAL_MS=60000

# USDC ERC-20 interface on Arc (same address on mainnet and testnet)
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Gateway Wallet contract on Arc Mainnet
GATEWAY_WALLET_ADDRESS=0x77777777Dcc4d5A8B6E418Fd04D8997ef11000eE

# Rate per minute in USDC (6 decimals) - e.g., "20000" = $0.02/min
DEFAULT_RATE_PER_MINUTE=20000

# DEPRECATED: Reserved for a future validated settlement worker. The current backend does
# not load this file or submit Arc transactions.
ARC_SETTLEMENT_CONTRACT_ADDRESS=
